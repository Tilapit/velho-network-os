{
  "name": "velho-network-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "reset": "node scripts/reset.mjs",
    "skill:zip": "mkdir -p dist && rm -f dist/velho-network-skill.zip && cd claude && zip -qrX ../dist/velho-network-skill.zip velho-network -x '*/.*' && cd .. && unzip -l dist/velho-network-skill.zip",
    "tunnel": "scripts/tunnel.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "geist": "^1.8.2",
    "next": "15.5.4",
    "papaparse": "^5.4.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.9"
  }
}
